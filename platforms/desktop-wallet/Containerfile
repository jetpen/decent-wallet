FROM python:3.12-slim-bookworm AS build

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/tmp/uv-cache \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
RUN python -m pip install --no-cache-dir "uv==0.12.19"
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable

FROM build AS conformance
RUN uv sync --locked --extra test --no-editable
COPY tests ./tests
ENV HOME=/tmp
WORKDIR /tmp
USER 65532:65532
CMD ["/opt/venv/bin/python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "/build/tests"]

FROM python:3.12-slim-bookworm AS runtime
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /wallet
COPY --from=build /opt/venv /opt/venv
USER 65532:65532
ENTRYPOINT ["decent-wallet"]
